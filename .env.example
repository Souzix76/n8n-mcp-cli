# n8n-mcp-cli environment configuration
# Copy to .env and fill in your values

# n8n instance URL (required)
N8N_BASE_URL=http://127.0.0.1:5678

# n8n API key (required)
# Get this from n8n UI: Settings > API Keys
N8N_API_KEY=your_n8n_api_key_here

# Default timeout for API requests (ms)
DEFAULT_TIMEOUT_MS=30000

# MCP server credential mode: read-only | external
# read-only (default): validation, diagnostics, health checks
# external: allows create_workflow and other write operations
CREDENTIAL_MODE=read-only